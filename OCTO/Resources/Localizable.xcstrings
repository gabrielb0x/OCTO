        }
      }
    },
    "No telemetry, no analytics, no third-party SDKs.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune télémétrie, aucune analyse, aucun SDK tiers."
          }
        }
      }
    },
    "No tracking in OCTO": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pistage dans OCTO"
          }
        }
      }
    },
    "No verification is needed for your account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune vérification n'est nécessaire pour ton compte."
          }
        }
      }
    },
    "No. OCTO has no telemetry, analytics or third-party SDK. Requests go straight from your device to OpenAI, and to GitHub to look for updates if you allow it. Your sign-in tokens stay in the iOS keychain, and Settings → Privacy lists every server OCTO contacted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non. OCTO n'a ni télémétrie, ni outil d'analyse, ni SDK tiers. Les requêtes partent directement de ton appareil vers OpenAI, et vers GitHub pour chercher les mises à jour si tu le permets. Tes jetons de connexion restent dans le trousseau iOS, et Réglages → Confidentialité liste chaque serveur contacté par OCTO."
          }
        }
      }
    },
    "None": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune"
          }
        }
      }
    },
    "Normal": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale"
          }
        }
      }
    },
    "Normal (%@ s)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale (%@ s)"
          }
        }
      }
    },
    "Nothing forces you to verify: without it, you keep using ChatGPT, with its protections for teens.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne t'oblige à la faire : sans vérification, tu continues d'utiliser ChatGPT, avec ses protections pour les ados."
          }
        }
      }
    },
    "Nothing was heard": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été entendu"
          }
        }
      }
    },
    "Notification in 5 seconds: leave OCTO to see it": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification dans 5 secondes : quitte OCTO pour la voir"
          }
        }
      }
    },
    "Notifications": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        }
      }
    },
    "Notifications are turned off for OCTO in iOS Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications d'OCTO sont désactivées dans les Réglages d'iOS."
