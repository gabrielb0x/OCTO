    "Layout": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disposition"
          }
        }
      }
    },
    "Like the ChatGPT app: slide the chat aside, or tap the button at the top left, to see your chats.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme l'app ChatGPT : fais glisser le chat sur le côté, ou touche le bouton en haut à gauche, pour voir tes chats."
          }
        }
      }
    },
    "More tabs": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autres onglets"
          }
        }
      }
    },
    "New chats start with the model chosen here. Each chat can switch model, thinking and speed from the top of the screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux chats commencent avec le modèle choisi ici. Chaque chat peut changer de modèle, de réflexion et de vitesse depuis le haut de l'écran."
          }
        }
      }
    },
    "No chats from your ChatGPT account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun chat de ton compte ChatGPT"
          }
        }
      }
    },
    "No chats written with Codex yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun chat écrit avec Codex pour l'instant"
          }
        }
      }
    },
    "Not included in your plan": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas inclus dans ton forfait"
          }
        }
      }
    },
    "OCTO asks Codex which models your account can use, keeps those it gives your plan, and leaves out any it turns down when a message is sent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCTO demande à Codex quels modèles ton compte peut utiliser, garde ceux qu'il donne à ton forfait et écarte ceux qu'il refuse à l'envoi d'un message."
          }
        }
      }
    },
    "OCTO looks through the chats on this iPhone, and ChatGPT inside the messages of your whole account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCTO cherche dans les chats de cet iPhone, et ChatGPT dans les messages de tout ton compte."
          }
        }
      }
    },
    "Offered to your plan": {
      "localizations": {
        "fr": {
          "stringUnit": {
