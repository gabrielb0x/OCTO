    },
    "Your real data controls": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes vrais réglages de données"
          }
        }
      }
    },
    "Your recording is sent to ChatGPT, which writes it down like in its apps, then deleted from the device. If ChatGPT can't, the device transcribes it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton enregistrement est envoyé à ChatGPT, qui l'écrit comme dans ses apps, puis il est effacé de l'appareil. Si ChatGPT n'y arrive pas, l'appareil le transcrit."
          }
        }
      }
    },
    "Your session has expired. Please sign in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta session a expiré. Reconnecte-toi."
          }
        }
      }
    },
    "Your sign-in tokens stay in the keychain of this device and are refreshed automatically.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes jetons de connexion restent dans le trousseau de cet appareil et sont actualisés automatiquement."
          }
        }
      }
    },
    "Your sign-in tokens stay in the keychain of this device and are refreshed automatically. Signing out, at the bottom of Settings, revokes the session of this device; to sign out everywhere, use ChatGPT.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes jetons de connexion restent dans le trousseau de cet appareil et sont renouvelés automatiquement. Se déconnecter, en bas des Réglages, révoque la session de cet appareil ; pour te déconnecter partout, passe par ChatGPT."
          }
        }
      }
    },
    "Your subscription is up to date: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton abonnement est à jour : %@"
          }
        }
      }
    },
    "Your subscription lets you choose the model of each chat.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton abonnement te permet de choisir le modèle de chaque chat."
          }
        }
      }
    },
    "Your voice is recorded, then written down by ChatGPT, like in its apps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta voix est enregistrée, puis écrite par ChatGPT, comme dans ses apps."
          }
