      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surnom"
          }
        }
      }
    },
    "No analytics, no ads, no third-party code. OCTO only talks to OpenAI for your account and, if you let it, to GitHub for updates.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun outil d'analyse, aucune publicité, aucun code tiers. OCTO ne parle qu'à OpenAI pour ton compte et, si tu le permets, à GitHub pour les mises à jour."
          }
        }
      }
    },
    "No archived chats.": {
      "localizations": {
        "fr": {
