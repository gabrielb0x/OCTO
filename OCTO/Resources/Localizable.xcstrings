          "stringUnit": {
            "state": "translated",
            "value": "Ton compte a les protections de ChatGPT pour les ados. Pour les lever, ChatGPT te demande de vérifier ton âge avec un selfie ou une pièce d'identité."
          }
        }
      }
    },
    "Your age is verified": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton âge est vérifié"
          }
        }
      }
    },
    "Your age status isn't loaded": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton statut d'âge n'est pas chargé"
          }
        }
      }
    },
    "Your chats and settings come from your ChatGPT account. Not affiliated with OpenAI.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes chats et tes réglages viennent de ton compte ChatGPT. Non affilié à OpenAI."
          }
        }
      }
    },
    "Your chats come from your ChatGPT account and are kept on this device so they open instantly.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes chats viennent de ton compte ChatGPT et sont gardés sur cet appareil pour s'ouvrir instantanément."
          }
        }
      }
    },
    "Your chats show again once the recording or sharing stops.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes chats réapparaissent dès que l'enregistrement ou le partage s'arrête."
          }
        }
      }
    },
    "Your chats will appear here": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes chats apparaîtront ici"
          }
        }
      }
    },
    "Your chats, projects, custom instructions, personality, memory and profile picture now come from your ChatGPT account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes chats, projets, instructions personnalisées, personnalité, mémoire et photo de profil viennent maintenant de ton compte ChatGPT."
          }
