    "Accounts without a subscription get ChatGPT's Upgrade in the top bar, and Appearance takes it away in one tap.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes sans abonnement retrouvent le « Mettre à niveau » de ChatGPT en haut de l'écran, et Apparence l'enlève d'une pression."
          }
        }
      }
    },
