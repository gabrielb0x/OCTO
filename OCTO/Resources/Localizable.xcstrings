    "What's new in OCTO": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveautés d'OCTO"
          }
        }
      }
    },
    "When “Reference saved memories” is on, your saved memories are sent with the messages you write in OCTO. OCTO can't reference your chat history.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand « Consulter les souvenirs enregistrés » est activé, tes souvenirs sont envoyés avec les messages que tu écris dans OCTO. OCTO ne peut pas consulter l'historique de tes chats."
          }
        }
      }
    },
