    "Home": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accueil"
          }
        }
      }
    },
    "In the tab bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
