    "How your ChatGPT account proves it's you. These are changed in ChatGPT.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment ton compte ChatGPT vérifie que c'est bien toi. Ces réglages se changent dans ChatGPT."
