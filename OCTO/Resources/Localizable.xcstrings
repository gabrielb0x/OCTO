    },
    "Fast and affordable agentic coding model.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle rapide et économique pour coder en mode agent."
          }
        }
      }
    },
    "Frontier model for complex coding, research, and real-world work.": {
      "localizations": {
        "fr": {
