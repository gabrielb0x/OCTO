      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta couleur"
          }
        }
      }
    },
    "Your details": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes informations"
          }
        }
      }
    },
    "Your email stays yours": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton e-mail reste à toi"
          }
        }
