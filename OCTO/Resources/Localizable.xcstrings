            "value": "Tu n'es pas connecté."
          }
        }
      }
    },
    "You've reached your ChatGPT usage limit. It resets at %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as atteint la limite d'utilisation de ton forfait ChatGPT. Elle se réinitialise à %@."
          }
        }
      }
    },
    "You've reached your ChatGPT usage limit. Try again later.": {
      "localizations": {
        "fr": {
