    "NSCameraUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "OCTO uses the camera so you can send photos in a chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCTO utilise l'appareil photo pour que tu puisses envoyer des photos dans un chat."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "OCTO briefly listens on this device (localhost) to receive the ChatGPT sign-in response."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCTO écoute brièvement sur cet appareil (localhost) pour recevoir la réponse de connexion ChatGPT."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "OCTO uses the microphone to dictate your messages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCTO utilise le micro pour dicter tes messages."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "OCTO transcribes your voice on your device to write your message."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OCTO transcrit ta voix sur ton appareil pour écrire ton message."
          }
        }
      }
    }
